{
  // Deploy: npx wrangler deploy --config _contact-worker/wrangler.jsonc
  // The inbox address is a secret, not in this file: npx wrangler secret put CONTACT_TO --config _contact-worker/wrangler.jsonc
  // It must be a destination address already verified under Email Routing in this Cloudflare account.
  "name": "martinapps-contact",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true }
}
